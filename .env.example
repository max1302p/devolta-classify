# Required: comma separated API keys (Authorization: Bearer <key> or X-API-Key)
API_KEYS=change-me-1,change-me-2

# CPU budget. Keep this small on a shared host.
NUM_THREADS=2
OMP_NUM_THREADS=2
MKL_NUM_THREADS=2
MAX_CONCURRENCY=2

# Optional
DEFAULT_HYPOTHESIS_TEMPLATE=Diese Nachricht betrifft {}.
PORT=8000
MODEL_ID=MoritzLaurer/bge-m3-zeroshot-v2.0
BACKEND=onnx

# Container limits (docker compose)
CPU_LIMIT=2.0
MEMORY_LIMIT=5g
